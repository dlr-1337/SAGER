# Copy outside the repository and pass --env-file with its absolute path.
SAGER_STACK_NAME=sager
SAGER_PUBLIC_HOST=sager.example.org
SAGER_SECRETS_DIR=/srv/sager/secrets
SAGER_TLS_DIR=/srv/sager/tls
SAGER_HTTP_PORT=80
SAGER_HTTPS_PORT=443
SAGER_BACKEND_IMAGE=sager-backend:local
SAGER_GATEWAY_IMAGE=sager-gateway:local
SAGER_INTEGRATIONS_WHATSAPP_ENABLED=false
