worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 512; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;
  log_format operational '$time_iso8601 $request_id $status $request_time $upstream_response_time';
  access_log /dev/stdout operational;
  client_body_temp_path /tmp/client;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  client_max_body_size 1m;
  client_body_timeout 15s;
  send_timeout 30s;
  keepalive_timeout 30s;

  include ${SAGER_COOLIFY_REALIP_FILE};
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;
  # This is the original TCP peer, before the trusted proxy rewrites remote_addr.
  geo $realip_remote_addr $sager_trusted_peer {
    default 0;
    include ${SAGER_COOLIFY_PEERS_FILE};
  }
  map $http_x_forwarded_proto $sager_https {
    default 0;
    ~^https$ 1;
  }
  map $http_host $sager_expected_host {
    default 0;
    ~*^${SAGER_PUBLIC_HOST_REGEX}(:443)?$ 1;
  }
  limit_req_zone $binary_remote_addr zone=login:1m rate=60r/m;
  limit_req_status 429;
  map $request_id $sager_request_id {
    '~^(?<rid_a>.{8})(?<rid_b>.{4})(?<rid_c>.{4})(?<rid_d>.{4})(?<rid_e>.{12})$' $rid_a-$rid_b-$rid_c-$rid_d-$rid_e;
  }
  # A hashed name that does not exist in this version answers 404, which must never be cached.
  map $status $sager_asset_cache {
    default no-store;
    200 'public, max-age=31536000, immutable';
    304 'public, max-age=31536000, immutable';
  }
  upstream sager_backend { server backend:8080; keepalive 8; }

  # Health is only available inside this container; never publish this listener.
  server {
    listen 127.0.0.1:8081;
    server_name _;
    access_log off;
    location = /readiness {
      if ($request_method != GET) { return 405; }
      default_type text/plain;
      return 200 'ready\n';
    }
    location / { return 404; }
  }
  server {
    listen 8080 default_server;
    listen [::]:8080 default_server;
    server_name _;
    return 444;
  }
  server {
    listen 8080;
    listen [::]:8080;
    server_name ${SAGER_PUBLIC_HOST};
    if ($sager_trusted_peer = 0) { return 403; }
    if ($sager_https = 0) { return 403; }
    if ($sager_expected_host = 0) { return 403; }
    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/sager-security-headers.conf;
    add_header Cache-Control no-store always;

    location = /api/v1/auth/login {
      limit_req zone=login burst=20 nodelay;
      error_page 429 = @login_limit;
      include /etc/nginx/sager-proxy.conf;
    }
    location @login_limit {
      default_type application/json;
      return 429 '{"code":"rate_limited","message":"Muitas tentativas. Aguarde e tente novamente.","requestId":"$sager_request_id"}';
    }
    # Exact upload routes only: every other request, the webhook included, keeps the 1 MiB limit.
    location ~ ^/api/v1/(?:conversas/[0-9a-fA-F-]+/mensagens|saidas-longas/[0-9a-fA-F-]+/autorizacao/arquivos)$ {
      client_max_body_size 11m;
      # The backend reads the CSRF token from the header only, so it refuses an anonymous upload
      # before parsing the body and writing it to the /tmp tmpfs.
      proxy_request_buffering off;
      include /etc/nginx/sager-proxy.conf;
    }
    location /api/ { include /etc/nginx/sager-proxy.conf; }
    location = /demonstracao { return 404; }
    location /actuator/ { return 404; }
    location = /readiness { return 404; }
    location ~ (^|/)\. { return 404; }
    # Only build output with a content hash is immutable; files from public/ keep no-store.
    location ~ "^/(?:(?:main|chunk|styles)-[A-Za-z0-9_-]{8}\.(?:js|css)|media/[^/]+-[A-Za-z0-9_-]{8}\.[A-Za-z0-9]+)$" {
      try_files $uri =404;
      include /etc/nginx/sager-security-headers.conf;
      add_header Cache-Control $sager_asset_cache always;
    }
    location ~* \.(?:js|css|woff2?|svg|png|jpe?g|ico)$ { try_files $uri =404; }
    location = /manifest.webmanifest { default_type application/manifest+json; try_files $uri =404; }
    location / {
      try_files $uri $uri/ /index.html;
      sub_filter '__SAGER_ORIGIN__' 'https://${SAGER_PUBLIC_HOST}';
      sub_filter_once off;
    }
  }
}
